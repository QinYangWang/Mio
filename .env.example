# ==============================================================================
# Mio · 环境变量配置模板
# 详见完整说明文档：docs/operations.md
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Slack 凭据与权限接入 (必填)
# ------------------------------------------------------------------------------
# Slack Bot Token (以 xoxb- 开头，具有 chat:write, channels:history 等权限)
SLACK_BOT_TOKEN=xoxb-your-bot-token

# Slack App-Level Token (以 xapp- 开头，必须具有 connections:write 权限)
SLACK_APP_TOKEN=xapp-your-app-token

# 授权监听与参与的频道 ID 列表 (逗号分隔，如 C0123456789,C0987654321)
CHANNEL_IDS=C0123456789

# 管理员 Slack User ID 列表 (逗号分隔，允许在授权频道执行 /companion 管理指令)
ADMIN_USER_IDS=U0123456789

# ------------------------------------------------------------------------------
# 2. 模型引擎与人设 (必填 API Key)
# ------------------------------------------------------------------------------
# OpenAI API 密钥
OPENAI_API_KEY=sk-your-openai-api-key

# 模型标识 (默认: gpt-6-sol，需在 Pi 支持目录中且当前账号可访问)
MODEL_ID=gpt-6-sol

# 机器人昵称 (默认: 小澪)
BOT_NAME=小澪

# 初始人设种子 (可选。首次启动时由模型根据此种子生成初始性格；后续成长不被此覆盖)
PERSONA_SEED=

# ------------------------------------------------------------------------------
# 3. 调度、节奏与并发控制 (包含硬性边界与限制)
# ------------------------------------------------------------------------------
# 运行业务时区 (默认: Asia/Taipei，用于计算静默时段与每日限额重置)
TIMEZONE=Asia/Taipei

# 夜间静默时段 (24小时制小时数，默认 23 到 8 点静默；两值相同表示关闭夜间静默)
QUIET_START=23
QUIET_END=8

# 普通群聊插话冷却时长 (秒，默认 90；直接 @ 呼叫可豁免冷却)
AMBIENT_COOLDOWN_SECONDS=90

# 主动发起话题最短间隔 (分钟，默认 180，系统硬性下限 5 分钟)
PROACTIVE_INTERVAL_MINUTES=180

# 每频道每天主动发起话题尝试上限 (默认 2 次，取值范围 0-20)
DAILY_PROACTIVE_LIMIT=2

# 全局允许并行处理的最大独立会话车道数 (默认 4，系统硬性范围 1-16)
MAX_CONCURRENT_LANES=4

# ------------------------------------------------------------------------------
# 4. 存储路径与网络出网安全
# ------------------------------------------------------------------------------
# 持久化存储根目录 (单实例独占，内部保存 SQLite 数据库与 Pi JSONL 会话历史)
DATA_DIR=./data

# 工具与动态插件允许请求的公网 HTTPS 域名白名单 (逗号分隔，严格禁止内网IP与重定向)
NETWORK_HOSTS=hacker-news.firebaseio.com,news.ycombinator.com
