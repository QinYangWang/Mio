{
  "name": "mio",
  "version": "1.0.0",
  "description": "Persistent, proactive Slack companion built with Bun and Pi Durable",
  "scripts": {
    "start": "bun src/main.ts",
    "dev": "bun --watch src/main.ts",
    "test": "bun test",
    "test:node": "node --experimental-transform-types --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "demo": "node --experimental-transform-types scripts/demo.ts",
    "hooks:install": "git config --local core.hooksPath .githooks"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@earendil-works/chord": "1.1.0",
    "@earendil-works/pi-ai": "1.1.0",
    "@earendil-works/pi-durable": "1.1.0",
    "@slack/bolt": "5.1.0"
  },
  "devDependencies": {
    "@types/bun": "1.4.2",
    "typescript": "5.9.3",
    "bun": "1.4.2"
  },
  "private": true,
  "engines": {
    "bun": ">=1.4.2",
    "node": ">=24"
  }
}
